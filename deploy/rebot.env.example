# Example env for deploy/docker-compose.seeed.yml (copy to repo-root `.env`)
MASTER_PORT=/dev/rebot-master
SLAVE_PORT=/dev/rebot-slave
# Active arm profiles (see backend/profiles); default = legacy pair
LEADER_PROFILE=violin_102
FOLLOWER_PROFILE=b601_dm
REBOT_BAUDRATE=921600
MASTER_BAUD=1000000
REBOT_UPDATE_HZ=30
REBOT_WS_PUSH_HZ=10
REBOT_RETURN_TIME=2.0
REBOT_TRANSITION_TIME=0.6
REBOT_RECOVER_BLEND_TIME=2.0
REBOT_SAFETY_DEFAULT=1
REBOT_SPIKE_THRESHOLD=1.5
REBOT_GRIPPER=1

# --- Voice (optional) ---
# VOICE_ENABLED=1
# VOICE_HEALTH_URL=http://127.0.0.1:1883/health
# VOICE_POLICY=follow_first
# VOICE_HEALTH_INTERVAL=5
# Sidecar: uv run uvicorn voice.app:app --host 0.0.0.0 --port 1883
# Optional ASR: VOICE_WHISPER_MODEL=/path/to/whisper-base
